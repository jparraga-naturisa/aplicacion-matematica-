/* ---------- Estado ---------- */
const state = {
  screen: 'home',      // home | category | problem | create
  categoryId: null,
  problemId: null,
  stepIndex: 0,
  stepStates: [],       // { answered, correct, attempts, hintShown, userLabel }
  createTarget: '__new__',
  createDraft: null,
  createError: ''
};
const completed = new Set();
let customIdCounter = 0;

function findCategory(id) { return CATEGORIES.find(c => c.id === id); }
function findProblem(catId, probId) {
  const cat = findCategory(catId);
  return cat ? cat.problems.find(p => p.id === probId) : null;
}
function totalProblems() { return CATEGORIES.reduce((s,c) => s + c.problems.length, 0); }

/* ---------- Render ---------- */
const app = document.getElementById('app');

function render() {
  if (state.screen === 'home') renderHome();
  else if (state.screen === 'category') renderCategoryView();
  else if (state.screen === 'problem') renderProblemView();
  else if (state.screen === 'create') renderCreateView();
}

function renderHome() {
  const done = completed.size;
  const total = totalProblems();
  const pct = total ? Math.round((done/total)*100) : 0;

  let html = `
    <header class="top">
      <h1>Aprende Ecuaciones y Funciones desde Problemas</h1>
      <p class="sub">Elige un tema, resuelve problemas de la vida real paso a paso y recibe retroalimentación inmediata.</p>
      <div class="overall-progress">
        <div class="bar"><div style="width:${pct}%"></div></div>
        <div class="label">${done}/${total} problemas completados</div>
      </div>
    </header>
    <div class="cards-grid">
  `;
  CATEGORIES.forEach(cat => {
    const catDone = cat.problems.filter(p => completed.has(p.id)).length;
    const catPct = Math.round((catDone / cat.problems.length) * 100);
    html += `
      <button class="card" onclick="goCategory('${cat.id}')">
        <span class="icon">${cat.icon}</span>
        <h3>${cat.name}</h3>
        <p>${cat.desc}</p>
        <div class="progress-line">
          <div class="mini-bar"><div style="width:${catPct}%"></div></div>
          <span>${catDone}/${cat.problems.length}</span>
        </div>
      </button>
    `;
  });
  html += `
      <button class="card create-card" onclick="goCreate('__new__')">
        <span class="icon">➕</span>
        <h3>Crear tu propio problema</h3>
        <p>Escribe tu propio enunciado y pasos, con tus propias preguntas y respuestas.</p>
      </button>
    </div>
  `;
  app.innerHTML = html;
}

function renderCategoryView() {
  const cat = findCategory(state.categoryId);
  let html = `
    <button class="btn-back" onclick="goHome()">← Volver a temas</button>
    <header class="top">
      <span class="demo-badge">${cat.icon} ${cat.name}</span>
      <h1>${cat.name}</h1>
      <p class="sub">${cat.desc}</p>
    </header>
    ${cat.concept ? `<div class="concept-box"><div class="concept-label">📘 Conceptos clave</div>${cat.concept}</div>` : ''}
    <div class="problem-list">
  `;
  if (cat.problems.length === 0) {
    html += `<p style="color:var(--muted); font-size:14px;">Todavía no hay problemas aquí. ¡Agrega el primero!</p>`;
  }
  cat.problems.forEach(p => {
    const done = completed.has(p.id);
    html += `
      <div class="problem-row">
        <div class="info">
          <h4>${p.title} ${p.custom ? '<span class="custom-badge">Tuyo</span>' : ''}</h4>
          <p>${p.statement}</p>
        </div>
        <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
          <div class="check-dot ${done ? 'done' : ''}">${done ? '✓' : ''}</div>
          <button class="btn-primary" onclick="goProblem('${cat.id}','${p.id}')">${done ? 'Repasar' : 'Resolver'}</button>
          ${p.custom ? `<button class="btn-secondary delete-btn" title="Eliminar problema" onclick="deleteCustomProblem('${cat.id}','${p.id}')">🗑️</button>` : ''}
        </div>
      </div>
    `;
  });
  html += `
    </div>
    <div class="actions-row" style="justify-content:flex-start; margin-top:18px;">
      <button class="btn-secondary" onclick="goCreate('${cat.id}')">+ Agregar un problema aquí</button>
    </div>
  `;
  app.innerHTML = html;
}

function deleteCustomProblem(catId, probId) {
  const cat = findCategory(catId);
  if (!cat) return;
  cat.problems = cat.problems.filter(p => p.id !== probId);
  completed.delete(probId);
  render();
}

function initStepStates(problem) {
  state.stepStates = problem.steps.map(() => ({ answered: false, correct: false, attempts: 0, hintShown: false, chosenIndex: null, chosenValue: null, workText: '' }));
}

function goHome() { state.screen = 'home'; render(); }
function goCategory(catId) { state.screen = 'category'; state.categoryId = catId; render(); }
function goProblem(catId, probId) {
  state.screen = 'problem'; state.categoryId = catId; state.problemId = probId; state.stepIndex = 0;
  const problem = findProblem(catId, probId);
  initStepStates(problem);
  render();
}

/* ---------- Crear tu propio problema ---------- */

function escapeAttr(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function newStepDraft(type) {
  return {
    type: type || 'mc',
    prompt: '',
    options: ['', '', ''],
    correctOption: 0,
    correctValue: '',
    tolerance: '0.01',
    unit: '',
    hint: ''
  };
}

function goCreate(targetCatId) {
  state.screen = 'create';
  state.createTarget = targetCatId || '__new__';
  state.createDraft = { title: '', statement: '', steps: [newStepDraft('mc')], summary: '' };
  state.createError = '';
  render();
}

function cancelCreate() {
  const back = (state.createTarget && state.createTarget !== '__new__') ? state.createTarget : null;
  state.createDraft = null;
  if (back && findCategory(back)) { goCategory(back); } else { goHome(); }
}

function setCreateTarget(value) {
  state.createTarget = value;
}

function updateDraftField(field, value) {
  state.createDraft[field] = value;
}

function updateStepField(idx, field, value) {
  state.createDraft.steps[idx][field] = value;
}

function updateStepOption(idx, optIdx, value) {
  state.createDraft.steps[idx].options[optIdx] = value;
}

function setStepCorrectOption(idx, optIdx) {
  state.createDraft.steps[idx].correctOption = optIdx;
}

function changeStepType(idx, type) {
  const old = state.createDraft.steps[idx];
  const fresh = newStepDraft(type);
  fresh.prompt = old.prompt;
  fresh.hint = old.hint;
  state.createDraft.steps[idx] = fresh;
  render();
}

function addStep() {
  state.createDraft.steps.push(newStepDraft('mc'));
  render();
}

function removeStep(idx) {
  if (state.createDraft.steps.length <= 1) return;
  state.createDraft.steps.splice(idx, 1);
  render();
}

function saveCreate() {
  const draft = state.createDraft;
  const title = (draft.title || '').trim();
  const statement = (draft.statement || '').trim();

  if (!title) { state.createError = 'Escribe un título para tu problema.'; render(); return; }
  if (!statement) { state.createError = 'Escribe el enunciado del problema.'; render(); return; }
  if (!draft.steps.length) { state.createError = 'Agrega al menos un paso.'; render(); return; }

  const finalSteps = [];
  for (let i = 0; i < draft.steps.length; i++) {
    const s = draft.steps[i];
    const prompt = (s.prompt || '').trim();
    if (!prompt) { state.createError = `Escribe la pregunta del paso ${i+1}.`; render(); return; }
    if (s.type === 'mc') {
      const filled = s.options.map(o => (o || '').trim()).filter(o => o !== '');
      if (filled.length < 2) { state.createError = `El paso ${i+1} necesita al menos 2 opciones escritas.`; render(); return; }
      const correctText = (s.options[s.correctOption] || '').trim();
      if (!correctText) { state.createError = `Marca cuál opción es la correcta en el paso ${i+1}.`; render(); return; }
      finalSteps.push({
        type: 'mc',
        prompt,
        options: filled,
        correct: filled.indexOf(correctText),
        hint: (s.hint || '').trim() || 'Piensa de nuevo en el enunciado del problema.'
      });
    } else {
      const correctValue = parseFloat(s.correctValue);
      if (isNaN(correctValue)) { state.createError = `Escribe una respuesta numérica válida en el paso ${i+1}.`; render(); return; }
      const tolerance = parseFloat(s.tolerance);
      finalSteps.push({
        type: 'num',
        prompt,
        correct: correctValue,
        tolerance: isNaN(tolerance) ? 0.01 : tolerance,
        unit: (s.unit || '').trim(),
        hint: (s.hint || '').trim() || 'Repasa el enunciado y vuelve a calcular con cuidado.'
      });
    }
  }

  customIdCounter++;
  const problem = {
    id: 'custom-' + Date.now() + '-' + customIdCounter,
    title,
    statement,
    steps: finalSteps,
    summary: (draft.summary || '').trim() || '¡Bien hecho! Completaste tu propio problema.',
    graph: null,
    custom: true
  };

  let targetCat;
  if (state.createTarget === '__new__' || !state.createTarget) {
    targetCat = findCategory('personalizados');
    if (!targetCat) {
      targetCat = { id: 'personalizados', icon: '📝', name: 'Mis problemas', desc: 'Problemas creados por ti.', concept: null, problems: [] };
      CATEGORIES.push(targetCat);
    }
  } else {
    targetCat = findCategory(state.createTarget);
  }
  targetCat.problems.push(problem);

  state.createDraft = null;
  goCategory(targetCat.id);
}

function renderCreateView() {
  const draft = state.createDraft;
  const targetOptions = [`<option svalue="__new__" ${state.createTarget === '__new__' ? 'selected' : ''}>📝 Mis problemas (nuevo tema)</option>`]
    .concat(CATEGORIES.map(c => `<option value="${c.id}" ${state.createTarget === c.id ? 'selected' : ''}>${c.icon} ${escapeAttr(c.name)}</option>`))
    .join('');

  let html = `
    <button class="btn-back" onclick="cancelCreate()">← Cancelar</button>
    <header class="top">
      <span class="demo-badge">✏️ Crear problema</span>
      <h1>Crea tu propio problema</h1>
      <p class="sub">Escribe un enunciado y los pasos para resolverlo, igual que los demás problemas de la app.</p>
    </header>
    <div class="create-form">
      <label class="form-label">¿En qué tema quieres guardarlo?</label>
      <select class="form-select" onchange="setCreateTarget(this.value)">${targetOptions}</select>

      <label class="form-label">Título del problema</label>
      <input type="text" class="form-input" placeholder="Ej: El viaje en autobús" value="${escapeAttr(draft.title)}" oninput="updateDraftField('title', this.value)">

      <label class="form-label">Enunciado</label>
      <textarea class="form-textarea" placeholder="Describe la situación o problema que se debe resolver..." oninput="updateDraftField('statement', this.value)">${escapeHtml(draft.statement)}</textarea>

      <h3 class="form-section-title">Pasos guiados</h3>
  `;

  draft.steps.forEach((step, idx) => {
    html += renderStepEditor(step, idx, draft.steps.length);
  });

  html += `
      <button class="btn-secondary" onclick="addStep()">+ Agregar paso</button>

      <label class="form-label" style="margin-top:18px;">Resumen o solución completa (opcional)</label>
      <textarea class="form-textarea" placeholder="Explica la solución completa que se mostrará al terminar..." oninput="updateDraftField('summary', this.value)">${escapeHtml(draft.summary)}</textarea>

      ${state.createError ? `<div class="feedback bad show" style="margin-top:12px;">✗ ${escapeHtml(state.createError)}</div>` : ''}

      <p class="create-note">Nota: los problemas que crees se guardan solo mientras esta página siga abierta en tu navegador; si la recargas o la cierras, se perderán.</p>

      <div class="actions-row">
        <button class="btn-secondary" onclick="cancelCreate()">Cancelar</button>
        <button class="btn-primary" onclick="saveCreate()">Guardar problema</button>
      </div>
    </div>
  `;

  app.innerHTML = html;
}

function renderStepEditor(step, idx, totalSteps) {
  let inner = '';
  if (step.type === 'mc') {
    inner = step.options.map((opt, i) => `
      <div class="mc-option-row">
        <input type="radio" name="correct-${idx}" ${step.correctOption === i ? 'checked' : ''} onchange="setStepCorrectOption(${idx}, ${i})">
        <input type="text" class="form-input" placeholder="Opción ${i+1}${i < 2 ? '' : ' (opcional)'}" value="${escapeAttr(opt)}" oninput="updateStepOption(${idx}, ${i}, this.value)">
      </div>
    `).join('') + `<p class="step-editor-help">Marca con el círculo cuál opción es la correcta.</p>`;
  } else {
    inner = `
      <div class="num-editor-row">
        <input type="number" step="any" class="form-input" placeholder="Respuesta correcta" value="${escapeAttr(step.correctValue)}" oninput="updateStepField(${idx}, 'correctValue', this.value)">
        <input type="number" step="any" class="form-input" placeholder="Tolerancia (ej. 0.01)" value="${escapeAttr(step.tolerance)}" oninput="updateStepField(${idx}, 'tolerance', this.value)">
        <input type="text" class="form-input" placeholder="Unidad (opcional, ej. km)" value="${escapeAttr(step.unit)}" oninput="updateStepField(${idx}, 'unit', this.value)">
      </div>
    `;
  }

  return `
    <div class="step-editor">
      <div class="step-editor-head">
        <strong>Paso ${idx + 1}</strong>
        <select class="form-select-inline" onchange="changeStepType(${idx}, this.value)">
          <option value="mc" ${step.type === 'mc' ? 'selected' : ''}>Opción múltiple</option>
          <option value="num" ${step.type === 'num' ? 'selected' : ''}>Respuesta numérica</option>
        </select>
        ${totalSteps > 1 ? `<button class="btn-secondary step-remove-btn" onclick="removeStep(${idx})">Eliminar</button>` : ''}
      </div>
      <input type="text" class="form-input" placeholder="Pregunta de este paso" value="${escapeAttr(step.prompt)}" oninput="updateStepField(${idx}, 'prompt', this.value)">
      ${inner}
      <input type="text" class="form-input" placeholder="Pista (opcional)" value="${escapeAttr(step.hint)}" oninput="updateStepField(${idx}, 'hint', this.value)">
    </div>
  `;
}

function renderProblemView() {
  const problem = findProblem(state.categoryId, state.problemId);
  const cat = findCategory(state.categoryId);
  const totalSteps = problem.steps.length;
  const allDone = state.stepIndex >= totalSteps;

  let html = `
    <button class="btn-back" onclick="goCategory('${cat.id}')">← Volver a ${cat.name}</button>
    <div class="statement-box">
      <h2>${problem.title}</h2>
      <p>${problem.statement}</p>
    </div>
    <div class="step-progress">
  `;
  for (let i = 0; i < totalSteps; i++) {
    let cls = 'step-dot';
    if (i < state.stepIndex || (allDone)) cls += ' past';
    else if (i === state.stepIndex) cls += ' current';
    html += `<div class="${cls}"></div>`;
  }
  html += `</div>`;

  // Past answered steps (recap)
  for (let i = 0; i < Math.min(state.stepIndex, totalSteps); i++) {
    const st = problem.steps[i];
    const ss = state.stepStates[i];
    const answerText = st.type === 'mc' ? st.options[ss.chosenIndex] : `${ss.chosenValue} ${st.unit || ''}`.trim();
    html += `
      <div class="past-step">
        <div class="ps-q">${i+1}. ${st.prompt}</div>
        <div class="ps-a">✓ ${answerText}</div>
        ${(st.explain || st.hint) ? `<div class="ps-explain">💡 ${st.explain || st.hint}</div>` : ''}
      </div>
    `;
  }

  if (!allDone) {
    const idx = state.stepIndex;
    const step = problem.steps[idx];
    const ss = state.stepStates[idx];
    html += `
      <div class="step-card">
        <div class="step-label">Paso ${idx+1} de ${totalSteps}</div>
        <p class="step-prompt">${step.prompt}</p>
        ${renderStepInput(step, ss, idx)}
        <div class="feedback ${ss.attempts > 0 ? 'show' : ''} ${ss.correct ? 'ok' : (ss.attempts > 0 ? 'bad' : '')}" id="feedback-${idx}">
          ${ss.correct ? '✓ ¡Correcto!' : (ss.attempts > 0 ? '✗ No es correcto todavía. Intenta de nuevo o revisa la pista.' : '')}
        </div>
        ${ss.correct
          ? `<div class="explain-box">💡 <strong>Explicación:</strong> ${step.explain || step.hint}</div>`
          : `<div class="hint-row">
              <button class="hint-link" onclick="toggleHint(${idx})">💡 ${ss.hintShown ? 'Ocultar pista' : 'Ver pista'}</button>
              <div class="hint-box ${ss.hintShown ? 'show' : ''}" id="hintbox-${idx}">${step.hint}</div>
            </div>`
        }
      </div>
      <div class="actions-row">
        <span></span>
        <button class="btn-primary" id="next-btn" ${ss.correct ? '' : 'disabled'} onclick="nextStep()">
          ${idx === totalSteps - 1 ? 'Ver solución completa' : 'Siguiente paso'}
        </button>
      </div>
    `;
  } else {
    html += `
      <div class="summary-box">
        <div class="tag">✓ ¡Problema resuelto!</div>
        <p>${problem.summary}</p>
        ${problem.graph ? renderGraphBlock(problem.graph) : ''}
      </div>
      <footer class="done-footer">
        <button class="btn-secondary" onclick="goCategory('${cat.id}')">Volver a ${cat.name}</button>
      </footer>
    `;
  }

  app.innerHTML = html;

  if (allDone) {
    completed.add(problem.id);
    if (problem.graph) drawGraphForCurrentProblem(problem.graph);
  }
}

function renderWorkArea(ss, idx) {
  return `
    <div class="work-area">
      <label class="work-label" for="work-${idx}">✏️ Espacio para resolver (borrador, opcional)</label>
      <textarea class="work-textarea" id="work-${idx}" placeholder="Escribe aquí tus cálculos, como en papel..." oninput="saveWork(${idx}, this.value)">${escapeHtml(ss.workText || '')}</textarea>
    </div>
  `;
}

function escapeHtml(str) {
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function saveWork(idx, value) {
  state.stepStates[idx].workText = value;
  // No se vuelve a renderizar aquí para no perder el foco mientras se escribe.
}

function renderStepInput(step, ss, idx) {
  const workArea = renderWorkArea(ss, idx);
  if (step.type === 'mc') {
    let html = workArea + '<div class="options">';
    step.options.forEach((opt, i) => {
      let cls = 'option-btn';
      if (ss.answered) {
        cls += ' disabled-choice';
        if (i === step.correct) cls += ' correct';
        else if (i === ss.chosenIndex) cls += ' wrong';
      }
      html += `<button class="${cls}" onclick="answerMC(${idx}, ${i})">${opt}</button>`;
    });
    html += '</div>';
    return html;
  } else {
    const unit = step.unit ? `<span class="unit-label">${step.unit}</span>` : '';
    return `
      ${workArea}
      <div class="num-input-row">
        <input type="number" step="any" id="numinput-${idx}" placeholder="tu respuesta" value="${ss.chosenValue !== null ? ss.chosenValue : ''}" ${ss.answered ? 'disabled' : ''}>
        ${unit}
        <button class="btn-secondary" ${ss.answered ? 'disabled' : ''} onclick="answerNum(${idx})">Comprobar</button>
      </div>
    `;
  }
}

function toggleHint(idx) {
  state.stepStates[idx].hintShown = !state.stepStates[idx].hintShown;
  render();
}

function answerMC(idx, chosenIndex) {
  const problem = findProblem(state.categoryId, state.problemId);
  const step = problem.steps[idx];
  const ss = state.stepStates[idx];
  if (ss.correct) return;
  ss.attempts++;
  ss.chosenIndex = chosenIndex;
  if (chosenIndex === step.correct) {
    ss.correct = true;
    ss.answered = true;
  }
  render();
}

function answerNum(idx) {
  const problem = findProblem(state.categoryId, state.problemId);
  const step = problem.steps[idx];
  const ss = state.stepStates[idx];
  const input = document.getElementById('numinput-' + idx);
  const val = parseFloat(input.value);
  ss.attempts++;
  if (!isNaN(val)) {
    ss.chosenValue = val;
    const tol = step.tolerance !== undefined ? step.tolerance : 0.01;
    if (Math.abs(val - step.correct) <= tol) {
      ss.correct = true;
      ss.answered = true;
    }
  }
  render();
}

function nextStep() {
  state.stepIndex++;
  render();
}

/* ---------- Gráficas (canvas) ---------- */

function renderGraphBlock(graph) {
  return `
    <div class="graph-wrap">
      <h4>Gráfica de la función</h4>
      <canvas class="graph-canvas" id="fn-canvas"></canvas>
      <div class="graph-legend">
        <div class="item"><span class="legend-swatch" style="background:var(--series-1)"></span> Función</div>
        <div class="item"><span class="legend-swatch" style="background:var(--series-2)"></span> Punto clave</div>
      </div>
    </div>
  `;
}

function cssVar(name) {
  return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
}

function drawGraphForCurrentProblem(graph) {
  const canvas = document.getElementById('fn-canvas');
  if (!canvas) return;

  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  const W = rect.width, H = rect.height;
  const pad = { top: 16, right: 20, bottom: 34, left: 46 };

  const colorGrid = cssVar('--grid') || '#e1e0d9';
  const colorAxis = cssVar('--baseline') || '#c3c2b7';
  const colorMuted = cssVar('--muted') || '#898781';
  const colorText = cssVar('--text-secondary') || '#52514e';
  const colorSeries1 = cssVar('--series-1') || '#2a78d6';
  const colorSeries2 = cssVar('--series-2') || '#eb6834';
  const colorSurface = cssVar('--surface-1') || '#fcfcfb';

  // sample function
  const N = 200;
  const xs = [];
  const ys = [];
  for (let i = 0; i <= N; i++) {
    const x = graph.xMin + (graph.xMax - graph.xMin) * (i / N);
    xs.push(x);
    ys.push(graph.fn(x));
  }
  let yMin = Math.min(...ys, 0);
  let yMax = Math.max(...ys, 0);
  if (graph.points) graph.points.forEach(p => { yMin = Math.min(yMin, p.y); yMax = Math.max(yMax, p.y); });
  const yPad = (yMax - yMin) * 0.12 || 1;
  yMin -= yPad; yMax += yPad;

  function toPx(x) { return pad.left + (x - graph.xMin) / (graph.xMax - graph.xMin) * (W - pad.left - pad.right); }
  function toPy(y) { return H - pad.bottom - (y - yMin) / (yMax - yMin) * (H - pad.top - pad.bottom); }

  function drawBase() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = colorSurface;
    ctx.fillRect(0, 0, W, H);

    // gridlines (horizontal)
    ctx.strokeStyle = colorGrid;
    ctx.lineWidth = 1;
    const rows = 5;
    ctx.font = '11px system-ui, sans-serif';
    ctx.fillStyle = colorMuted;
    for (let i = 0; i <= rows; i++) {
      const y = yMin + (yMax - yMin) * (i / rows);
      const py = toPy(y);
      ctx.beginPath();
      ctx.moveTo(pad.left, py);
      ctx.lineTo(W - pad.right, py);
      ctx.stroke();
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(y.toFixed(y % 1 === 0 ? 0 : 1), pad.left - 8, py);
    }
    // x axis ticks
    const cols = 6;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let i = 0; i <= cols; i++) {
      const x = graph.xMin + (graph.xMax - graph.xMin) * (i / cols);
      const px = toPx(x);
      ctx.fillText(x.toFixed(x % 1 === 0 ? 0 : 1), px, H - pad.bottom + 8);
    }

    // baseline (y=0) if within range
    if (yMin < 0 && yMax > 0) {
      ctx.strokeStyle = colorAxis;
      ctx.lineWidth = 1.5;
      const py0 = toPy(0);
      ctx.beginPath();
      ctx.moveTo(pad.left, py0);
      ctx.lineTo(W - pad.right, py0);
      ctx.stroke();
    }
    // y axis baseline
    ctx.strokeStyle = colorAxis;
    ctx.beginPath();
    ctx.moveTo(pad.left, pad.top);
    ctx.lineTo(pad.left, H - pad.bottom);
    ctx.stroke();

    // curve
    ctx.strokeStyle = colorSeries1;
    ctx.lineWidth = 2;
    ctx.beginPath();
    xs.forEach((x, i) => {
      const px = toPx(x), py = toPy(ys[i]);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    });
    ctx.stroke();

    // key points
    if (graph.points) {
      graph.points.forEach(p => {
        const px = toPx(p.x), py = toPy(p.y);
        ctx.fillStyle = colorSeries2;
        ctx.beginPath();
        ctx.arc(px, py, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = colorSurface;
        ctx.lineWidth = 2;
        ctx.stroke();
      });
    }

    // axis labels
    ctx.fillStyle = colorText;
    ctx.font = '12px system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    ctx.fillText(graph.xLabel || '', W / 2, H - 4);
  }

  function drawHover(mx) {
    drawBase();
    const relX = (mx - pad.left) / (W - pad.left - pad.right);
    if (relX < 0 || relX > 1) return;
    const x = graph.xMin + (graph.xMax - graph.xMin) * relX;
    const y = graph.fn(x);
    const px = toPx(x), py = toPy(y);

    ctx.strokeStyle = colorMuted;
    ctx.setLineDash([3, 3]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, pad.top);
    ctx.lineTo(px, H - pad.bottom);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = colorSeries1;
    ctx.beginPath();
    ctx.arc(px, py, 4, 0, Math.PI * 2);
    ctx.fill();

    const label = `(${x.toFixed(1)}, ${y.toFixed(1)})`;
    ctx.font = '12px system-ui, sans-serif';
    const tw = ctx.measureText(label).width;
    let boxX = px + 8;
    if (boxX + tw + 12 > W - pad.right) boxX = px - tw - 20;
    const boxY = Math.max(pad.top, py - 24);
    ctx.fillStyle = colorSeries1;
    ctx.fillRect(boxX, boxY, tw + 12, 20);
    ctx.fillStyle = '#ffffff';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(label, boxX + 6, boxY + 10);
  }

  drawBase();
  canvas.onmousemove = (e) => {
    const r = canvas.getBoundingClientRect();
    drawHover(e.clientX - r.left);
  };
  canvas.onmouseleave = () => drawBase();
}

render();
</script>
</body>
</html>